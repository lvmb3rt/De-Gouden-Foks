				float3 targetUpOS = float3(0, 1, 0);
				switch((targetUp))
				{
					case 0:
					{
						float3 worldUpOS = normalize(mul((float3x3)unity_WorldToObject, float3(0, 1, 0)));
						float proj = dot(worldUpOS, targetFwdOS);
						targetUpOS = normalize(worldUpOS - proj * targetFwdOS);
